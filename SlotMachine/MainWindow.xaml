<Window x:Class="SlotMachine.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Félkarú rabló"
        Height="500"
        Width="800">
	<Grid>

		<Grid.RowDefinitions>
			<RowDefinition Height="270"/>
			<RowDefinition Height="200"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<Rectangle HorizontalAlignment="Center" Height="60" Margin="0,-40,0,0" Stroke="DarkOrange" StrokeThickness="2" Fill="DarkOrange" VerticalAlignment="Top" Width="591"/>

		<Rectangle HorizontalAlignment="Left" Height="112" Margin="102,10,0,0" Stroke="DarkOrange" StrokeThickness="2" Fill="DarkOrange" VerticalAlignment="Top" Width="599" Grid.Row="1"/>

		<Rectangle HorizontalAlignment="Left" Height="401" Margin="592,-12,0,0" Stroke="DarkOrange" StrokeThickness="2" Fill="DarkOrange" VerticalAlignment="Top" Width="108" Grid.RowSpan="2"/>

		<Rectangle HorizontalAlignment="Left" Height="401" Margin="97,-11,0,0" Stroke="DarkOrange" StrokeThickness="2" Fill="DarkOrange" VerticalAlignment="Top" Width="101" Grid.RowSpan="2"/>

		<Rectangle HorizontalAlignment="Center" Height="264" Margin="0,20,0,0" Stroke="Yellow" StrokeThickness="8" VerticalAlignment="Top" Width="404" Grid.RowSpan="2"/>

		<Grid Grid.Row="0"
              HorizontalAlignment="Center"
              Margin="0,30,0,0" Width="360">

			<Grid.ColumnDefinitions>
				<ColumnDefinition/>
				<ColumnDefinition/>
				<ColumnDefinition/>
			</Grid.ColumnDefinitions>

			<Border Grid.Column="0" Width="120" Height="240" ClipToBounds="True">
				<Canvas x:Name="reel1"/>
			</Border>

			<Border Grid.Column="1" Width="120" Height="240" ClipToBounds="True">
				<Canvas x:Name="reel2"/>
			</Border>

			<Border Grid.Column="2" Width="120" Height="240" ClipToBounds="True">
				<Canvas x:Name="reel3"/>
			</Border>

			<Canvas Grid.ColumnSpan="3" IsHitTestVisible="False">

				<Line X1="-12" Y1="120" X2="372" Y2="120"
                      Stroke="Red" StrokeThickness="3"/>

				<Line X1="-12" Y1="80" X2="372" Y2="80"
                      Stroke="Gray" StrokeThickness="1" Opacity="0.5"/>

				<Line X1="-12" Y1="160" X2="372" Y2="160"
                      Stroke="Gray" StrokeThickness="1" Opacity="0.5"/>

			</Canvas>
		</Grid>
		<TextBlock x:Name="eredmenySzoveg"
           Grid.Row="1"
           FontSize="40"
           HorizontalAlignment="Left"
           VerticalAlignment="Top"
           Margin="285,126,0,0"
           RenderTransformOrigin="0.5,0.5"
           TextWrapping="NoWrap"/>
		<Button x:Name="PorgetesGomb"
                    Content="Pörgetés (10)"
                    Click="Porgetes_Click"
                    Margin="324,32,336,105" Grid.Row="1" Background="Yellow"/>
		<TextBlock x:Name="egyenlegKiiras"
           Text="Egyenleg: 100"
           FontSize="16"
           Margin="476,33,0,79"
           Grid.Row="1"
           HorizontalAlignment="Left"
           VerticalAlignment="Top"
				   Background="Yellow"/>

	</Grid>
</Window>
 